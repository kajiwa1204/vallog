# -----------------------------------------------
# 本番用の設定値（必ず安全な値に変更すること）
# -----------------------------------------------

# 環境（dev / prod）
ENV=prod

# PostgreSQL
POSTGRES_USER=vallog
# 注意: 本番環境では必ず安全なパスワードに変更すること
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vallog_db
DATABASE_URL=postgresql+asyncpg://vallog:<password>@db:5432/vallog_db

# GitHub OAuth
# https://github.com/settings/developers で取得
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT（openssl rand -hex 32 で生成すること）
JWT_SECRET=

# GitHub アクセストークンの暗号化キー（python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" で生成すること）
ENCRYPTION_KEY=

# Cloudflare Tunnel
# https://dash.cloudflare.com/ > Zero Trust > Tunnels で取得
CLOUDFLARE_TUNNEL_TOKEN=

# フロントエンドURL
FRONTEND_URL=https://your-domain.com

# Claude API（貢献サマリー生成用。未設定の場合、サマリー生成APIは503を返す）
ANTHROPIC_API_KEY=

# LLMプロバイダ設定
# デフォルトは "claude"。無料で使う場合は以下のいずれかを選択する:
#   - SUMMARY_PROVIDER=ollama（完全無料ローカル・要 `docker compose --profile ollama up -d` + `ollama pull qwen3:4b-instruct`）
#   - SUMMARY_PROVIDER=openai + Gemini API無料枠: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SUMMARY_PROVIDER=claude
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=
OPENAI_PR_SUMMARY_MODEL=qwen3:4b-instruct
OPENAI_MEMBER_SUMMARY_MODEL=qwen3:4b-instruct
