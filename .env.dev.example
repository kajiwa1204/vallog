# -----------------------------------------------
# ローカル開発用の初期値（本番では必ず変更すること）
# -----------------------------------------------

# 環境（dev / prod）
ENV=dev

# PostgreSQL
POSTGRES_USER=vallog
POSTGRES_PASSWORD=root
POSTGRES_DB=vallog_db
DATABASE_URL=postgresql+asyncpg://vallog:root@db:5432/vallog_db

# GitHub OAuth
# https://github.com/settings/developers で取得
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT（openssl rand -hex 32 で生成）
JWT_SECRET=dev-jwt-secret

# GitHub アクセストークンの暗号化キー（python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" で生成すること）
ENCRYPTION_KEY=

# Cloudflare Tunnel
# ローカルでは使用しないため、空のままにしておくこと
CLOUDFLARE_TUNNEL_TOKEN=

# フロントエンドURL
FRONTEND_URL=http://localhost:3000

# 認証Cookieに Secure 属性を付けるか。dev構成では false が既定なので通常は設定不要
# COOKIE_SECURE=false

# 認証Cookieを送る対象パス（既定 /api/auth）。ブラウザから見たパスなので、
# Next の rewrites（/api/:path* → backend /:path*）を通した後の値を指定する。
# NEXT_PUBLIC_API_BASE_URL でバックエンドを別オリジンにする場合は、
# そのオリジン上での実際のパス（root_path なしなら /auth）に合わせる必要がある。
# バックエンドを直叩きする経路（localhost:8000/docs 等）ではCookieが送られない点にも注意
# AUTH_COOKIE_PATH=/api/auth

# GitHubキャッシュのTTL（秒）。省略時のデフォルトは300
GITHUB_CACHE_TTL_SECONDS=300


# -----------------------------------------------
# 貢献サマリー生成 LLM プロバイダ設定
# SUMMARY_PROVIDER: claude / openai / ollama
# -----------------------------------------------
SUMMARY_PROVIDER=ollama

# Claude（SUMMARY_PROVIDER=claude の場合に必要）
CLAUDE_API_KEY=
CLAUDE_PR_MODEL=claude-haiku-4-5-20251001
CLAUDE_MEMBER_MODEL=claude-haiku-4-5-20251001
CLAUDE_PR_CONCURRENCY=5
CLAUDE_MEMBER_CONCURRENCY=3
# Haiku非対応。0で無効化
CLAUDE_THINKING_BUDGET_TOKENS=1024

# OpenAI互換（SUMMARY_PROVIDER=openai の場合）
# Ollama の /v1 エンドポイント・Gemini 無料枠等にも使用可
# 注意: OPENAI_API_KEY が空の場合は Authorization ヘッダを送らない
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_PR_MODEL=gpt-5-nano
OPENAI_MEMBER_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=minimal
OPENAI_PR_CONCURRENCY=5
OPENAI_MEMBER_CONCURRENCY=3

# Ollama ネイティブ（SUMMARY_PROVIDER=ollama の場合）
# OpenAI互換エンドポイントではなく /api/chat を使う（think:false が確実に効くため）
# Docker VM 7.8GB では qwen3:8b はOOM → qwen3:4b-instruct / gemma3:4b を推奨
# OLLAMA_CONTEXT_LENGTH: デフォルト4096ではdiffが切り捨てられるため引き上げる
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_PR_MODEL=qwen3:4b-instruct
OLLAMA_MEMBER_MODEL=qwen3:4b-instruct
OLLAMA_PR_CONCURRENCY=2
OLLAMA_MEMBER_CONCURRENCY=1
