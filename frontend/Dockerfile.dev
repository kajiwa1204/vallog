FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; \
    elif [ -f package.json ]; then npm install; \
    else echo "Missing package.json in frontend build context" >&2; exit 1; \
    fi
COPY . .
EXPOSE 3000
CMD ["npm", "run", "dev"]
