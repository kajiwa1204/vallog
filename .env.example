# PostgreSQL
POSTGRES_USER=vallog
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vallog_db

# GitHub OAuth
# https://github.com/settings/developers で取得
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT（openssl rand -hex 32 で生成）
JWT_SECRET=

# Cloudflare Tunnel
# https://dash.cloudflare.com/ > Zero Trust > Tunnels で取得
CLOUDFLARE_TUNNEL_TOKEN=

# フロントエンドURL（GitHub OAuth コールバック用）
FRONTEND_URL=https://your-domain.com
