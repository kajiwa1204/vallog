# -----------------------------------------------
# ローカル開発用の初期値（本番では必ず変更すること）
# -----------------------------------------------

# 環境（dev / prod）
ENV=dev

# PostgreSQL
POSTGRES_USER=vallog
POSTGRES_PASSWORD=root
POSTGRES_DB=vallog_db
DATABASE_URL=postgresql+asyncpg://vallog:root@localhost:5432/vallog_db

# GitHub OAuth
# https://github.com/settings/developers で取得
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT（本番では openssl rand -hex 32 で生成すること）
JWT_SECRET=dev-jwt-secret

# GitHub アクセストークンの暗号化キー（本番では python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" で生成すること）
ENCRYPTION_KEY=sHqjhZRfvdajGgAAuFsNC7OaVRCMKJPIyY7c07YUa3Y=

# Cloudflare Tunnel
# https://dash.cloudflare.com/ > Zero Trust > Tunnels で取得
# ローカルでは使用しないため、空のままにしておくこと
CLOUDFLARE_TUNNEL_TOKEN=

# フロントエンドURL（GitHub OAuth コールバック用）
FRONTEND_URL=http://localhost:3000
